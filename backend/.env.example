# SIAA Backend — Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# ─── Servidor ─────────────────────────────────────
PORT=8080
APP_ENV=development
APP_VERSION=0.1.0-dev
APP_COMMIT=local

# ─── MongoDB ──────────────────────────────────────
# Opción 1: MongoDB nativo instalado en Windows (Servicio local + Compass)
MONGO_URI=mongodb://127.0.0.1:27017

# Opción 2: MongoDB en Docker en puerto alterno (convive con MongoDB de Windows sin conflictos)
# MONGO_URI=mongodb://127.0.0.1:27018

# Opción 3: Backend ejecutándose dentro de un contenedor Docker conectado a MongoDB nativo de Windows
# MONGO_URI=mongodb://host.docker.internal:27017

MONGO_DB=siaa_dev
MONGO_PORT=27018

# ─── JWT ──────────────────────────────────────────
# ⚠ CAMBIAR en producción: mínimo 32 caracteres aleatorios
JWT_SECRET=siaa-dev-secret-CHANGE-ME-in-production-min-32chars
JWT_ISSUER=siaa
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# ─── Seguridad ────────────────────────────────────
FAILED_LOGIN_MAX=5
FAILED_LOGIN_WINDOW_MIN=15
LOCKOUT_DURATION_MIN=15
RATE_LIMIT_PER_MINUTE=120
PASSWORD_MIN_LENGTH=12

# ─── Dominios de correo permitidos ────────────────
# Dejar vacío para permitir cualquier dominio (solo desarrollo)
# En producción: ALLOWED_EMAIL_DOMAINS=universidad.edu.co,otra.edu.co
ALLOWED_EMAIL_DOMAINS=

# ─── CORS ─────────────────────────────────────────
# En desarrollo: * (permite cualquier origen localhost:puerto para web y emuladores)
# En producción: https://*.siaa.edu.co
CORS_ALLOWED_ORIGINS=*

# ─── Correo SMTP ──────────────────────────────────
# En desarrollo se usa MailHog (puerto 1025, sin auth)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@siaa.local

# ─── Recuperación de contraseña ───────────────────
RECOVERY_TOKEN_MINUTES=30

# ─── Parámetros GPS por defecto (SRS §3.5) ────────
DEFAULT_HOLGURA_ENTRADA_ANTES=15
DEFAULT_HOLGURA_ENTRADA_DESPUES=15
DEFAULT_UMBRAL_TARDANZA=10
DEFAULT_PRECISION_GPS_MAX=35.0
DEFAULT_BUFFER_PERIMETRAL=10.0
